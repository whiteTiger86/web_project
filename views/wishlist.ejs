<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>내 위시리스트</title>
    <style>
        main { max-width: 1200px; margin: 40px auto; padding: 20px 50px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 30px; margin-top: 20px; }
        .product-card { background-color: #fff; padding: 15px; border-radius: 8px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-img { width: 100%; height: 200px; margin-bottom: 15px; }
        .product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
        .btn-remove { width: 100%; padding: 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-cart { width: 100%; padding: 10px; background-color: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    </style>
</head>
<body>

<%- include('partials/header') %>

<main>
    <h2 style="border-bottom: 2px solid #333; padding-bottom: 10px;">♥ 내 위시리스트</h2>
    <section class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(function(p) { %>
                <div class="product-card">
                    <a href="/product/<%= p.id %>">
                        <div class="product-img"><img src="/images/<%= p.image %>" alt="<%= p.name %>"></div>
                        <h3><%= p.name %></h3>
                        <p style="color: #007bff; font-weight: bold;"><%= p.price.toLocaleString() %>원</p>
                    </a>
                    <div style="display: flex; gap: 5px; margin-top: 15px;">
                        <form action="/wishlist/to-cart/<%= p.id %>" method="POST" style="flex: 1;">
                            <button type="submit" class="btn-cart">장바구니로</button>
                        </form>
                        <form action="/wishlist/remove/<%= p.id %>" method="POST" style="flex: 1;">
                            <button type="submit" class="btn-remove">삭제</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="grid-column: 1/-1; padding: 50px 0; text-align: center; color: #666;">위시리스트가 비어있습니다.</div>
        <% } %>
    </section>
</main>
</body>
</html>