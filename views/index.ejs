<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>쇼핑몰 메인페이지</title>
    <style>
        /* 메인페이지 전용 디자인만 남깁니다 */
        main { max-width: 1200px; margin: 0 auto; padding: 20px 50px; }
        .banner { background-color: #007bff; color: #fff; padding: 40px; font-size: 24px; font-weight: bold; text-align: center; border-radius: 8px; margin-bottom: 40px; }
        h2 { font-size: 22px; margin-bottom: 20px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 30px; margin-bottom: 50px; }
        .product-card { background-color: #fff; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); text-align: center; }
        .product-img { width: 100%; height: 200px; margin-bottom: 15px; }
        .product-img img { width: 100%; height: 100%; object-fit: cover; }
        footer { background-color: #333; color: #fff; text-align: center; padding: 20px; font-size: 14px; margin-top: 50px; }
    </style>
</head>
<body>

<%- include('partials/header') %>

<main>
    <section class="banner"><div id="banner-text"><span>쇼핑몰 오픈 기념 전 상품 10% 할인!</span></div></section>
    <h2>베스트 추천 상품</h2>

    <section class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(function(p) { %>
                <div class="product-card">
                    <a href="/product/<%= p.id %>" style="display: block;">
                        <div class="product-img"><img src="/images/<%= p.image %>" alt="<%= p.name %>"></div>
                        <h3><%= p.name %></h3>
                        <p style="color: #007bff; font-weight: bold;"><%= p.price.toLocaleString() %>원</p>
                    </a>
                </div>
            <% }); %>
        <% } %>
    </section>
</main>
<footer><p>2026 웹프로그래밍 기말과제</p></footer>
</body>
</html>