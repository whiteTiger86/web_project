<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>내 장바구니</title>
    <style>
        main { max-width: 1200px; margin: 40px auto; padding: 20px 50px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 30px; margin-top: 20px; }
        .product-card { background-color: #fff; padding: 15px; border-radius: 8px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-img { width: 100%; height: 200px; margin-bottom: 15px; }
        .product-img img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
        .btn-remove { width: 100%; padding: 10px; background-color: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>

<%- include('partials/header') %>

<main>
    <h2 style="border-bottom: 2px solid #333; padding-bottom: 10px;">🛒 내 장바구니</h2>
    <section class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(function(p) { %>
                <div class="product-card">
                    <a href="/product/<%= p.id %>">
                        <div class="product-img"><img src="/images/<%= p.image %>" alt="<%= p.name %>"></div>
                        <h3><%= p.name %></h3>
                        <p style="color: #007bff; font-weight: bold;"><%= p.price.toLocaleString() %>원</p>
                    </a>
                    <form action="/cart/remove/<%= p.id %>" method="POST">
                        <button type="submit" class="btn-remove">삭제하기</button>
                    </form>
                </div>
            <% }); %>
        <% } else { %>
            <div style="grid-column: 1/-1; padding: 50px 0; text-align: center; color: #666;">장바구니가 비어있습니다.</div>
        <% } %>
    </section>

    <% if (products && products.length > 0) { %>
        <% let totalPrice = 0; products.forEach(function(p) { totalPrice += p.price; }); %>
        <div style="margin-top: 40px; padding: 30px; background-color: #fff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); text-align: right;">
            <h3 style="margin-bottom: 20px; font-size: 20px;">총 결제 금액: <span style="color: #007bff; font-size: 28px;"><%= totalPrice.toLocaleString() %>원</span></h3>
            <form action="/cart/checkout" method="POST" style="display: inline-block;" onsubmit="return confirm('총 <%= totalPrice.toLocaleString() %>원을 결제하시겠습니까?');">
                <button type="submit" style="padding: 15px 40px; background-color: #007bff; color: white; border: none; border-radius: 6px; font-size: 18px; font-weight: bold; cursor: pointer;">결제하기</button>
            </form>
        </div>
    <% } %>
</main>
</body>
</html>