<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>전체 상품 목록</title>
    <style>
        main { max-width: 1200px; margin: 40px auto; padding: 20px 50px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 30px; margin-top: 20px; }
        .product-card { background-color: #fff; padding: 15px; border-radius: 8px; text-align: center; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .product-img { width: 100%; height: 200px; margin-bottom: 15px; }
        .product-img img { width: 100%; height: 100%; object-fit: cover; }
        /* 페이징 버튼 스타일 */
        .pagination { display: flex; justify-content: center; gap: 5px; margin-top: 40px; }
        .pagination a, .pagination span { padding: 8px 14px; border: 1px solid #ddd; background-color: #fff; border-radius: 4px; font-size: 14px; }
        .pagination .active { background-color: #007bff; color: #fff; border-color: #007bff; }
    </style>
</head>
<body>

<%- include('partials/header') %>

<main>
    <h2>전체 상품 리스트</h2>
    <section class="product-grid">
        <% products.forEach(function(p) { %>
            <div class="product-card">
                <a href="/product/<%= p.id %>" style="display: block;">
                    <div class="product-img"><img src="/images/<%= p.image %>" alt="<%= p.name %>"></div>
                    <h3><%= p.name %></h3>
                    <p style="color: #007bff; font-weight: bold;"><%= p.price.toLocaleString() %>원</p>
                </a>
            </div>
        <% }); %>
    </section>

    <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
                <span class="active"><%= i %></span>
            <% } else { %>
                <a href="/products?page=<%= i %>"><%= i %></a>
            <% } %>
        <% } %>
    </div>
</main>
</body>
</html>